<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 内容区：Home / Demo 两个 Fragment 在此切换 -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu" />

    <!-- Bottom fixed Tab bar -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- left tab: 首页 -->
        <LinearLayout
            android:id="@+id/tabDemo"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_view"
                android:duplicateParentState="true"
                app:tint="@color/nav_tab_color"
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                android:text="Demo"
                android:duplicateParentState="true"
                android:textColor="@color/nav_tab_color"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- center spacer: raised GameCenter overlaps here -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- right tab: About -->
        <LinearLayout
            android:id="@+id/tabAbout"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_info_details"
                android:duplicateParentState="true"
                app:tint="@color/nav_tab_color"
                android:layout_width="24dp"
                android:layout_height="24dp" />

            <TextView
                android:text="About"
                android:duplicateParentState="true"
                android:textColor="@color/nav_tab_color"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- center raised GameCenter (圆形，微凸) -->
    <FrameLayout
        android:id="@+id/gameCenterRaised"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_game_center_raised"
        android:elevation="12dp"
        android:outlineProvider="none"
        android:translationY="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu">

        <com.unite.sdk.view.GameCenterView
            android:id="@+id/gameCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
